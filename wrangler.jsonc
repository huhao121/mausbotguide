{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mausbotguide",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	// Production is served only on the custom domain.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "mausbotguide.com", "custom_domain": true }]
}
