---
/**
 * Theme-aware diagram. Expects src/assets/diagrams/<name>.<lang>.<light|dark>.svg
 * (generated with the baoyu-diagram conventions) and shows the one matching the site theme.
 */
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
}
const { name, alt } = Astro.props;
const lang = Astro.currentLocale === 'zh-CN' ? 'zh' : 'en';
const files = import.meta.glob<ImageMetadata>('../assets/diagrams/*.svg', { eager: true, import: 'default' });
const pick = (theme: 'light' | 'dark') => {
	const img = files[`../assets/diagrams/${name}.${lang}.${theme}.svg`];
	if (!img) throw new Error(`Diagram not found: ${name}.${lang}.${theme}.svg`);
	return img;
};
const light = pick('light');
const dark = pick('dark');
---

<figure class="mbg-diagram not-content">
	<img class="light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />
	<img class="dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" />
</figure>

<style>
	.mbg-diagram {
		margin: 1.5rem 0;
	}
	.mbg-diagram img {
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 16px;
	}
	.mbg-diagram .light {
		display: none;
	}
	:global(:root[data-theme='light']) .mbg-diagram .light {
		display: block;
	}
	:global(:root[data-theme='light']) .mbg-diagram .dark {
		display: none;
	}
</style>
