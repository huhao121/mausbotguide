---
/**
 * Illustration at the top of a page. Images live in src/assets/illustrations/<name>.webp
 * (AI-generated in one consistent style; no text in the artwork).
 */
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	caption?: string;
}
const { name, alt, caption } = Astro.props;
const files = import.meta.glob<ImageMetadata>('../assets/illustrations/*.webp', { eager: true, import: 'default' });
const img = files[`../assets/illustrations/${name}.webp`];
if (!img) throw new Error(`Illustration not found: ${name}.webp`);
---

<figure class="mbg-figure not-content">
	<img src={img.src} width={img.width} height={img.height} alt={alt} loading="lazy" decoding="async" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.mbg-figure {
		margin: 2rem 0;
	}
	.mbg-figure img {
		width: 100%;
		height: auto;
		border-radius: 16px;
		border: 1px solid var(--sl-color-hairline-shade);
		background: #faf7f0;
	}
	.mbg-figure figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
